      "@types/react-dom": "19.2.5"
    },
    "onlyBuiltDependencies": [
      "@sentry/cli",
      "sharp"
    ]
  },
  "packageManager": "pnpm@10.3.0",
  "volta": {
    "node": "24.11.1"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
