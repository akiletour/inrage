    "gsap": "^3.13.0",
    "import-in-the-middle": "^2.0.0",
    "moment": "^2.30.1",
    "motion": "^12.23.25",
    "next": "^16.0.7",
    "next-sitemap": "^4.2.3",
    "postcss": "^8.5.6",
    "prop-types": "^15.8.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.68.0",
